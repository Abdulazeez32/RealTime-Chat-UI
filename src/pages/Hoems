                  <div key={m.id} className="flex items-center gap-2.5 p-1.5 rounded-xl hover:bg-white transition-colors cursor-pointer">
                    <Badge
                      overlap="circular"
                      anchorOrigin={{ vertical: "bottom", horizontal: "right" }}
                      variant="dot"
                      sx={{
                        "& .MuiBadge-badge": {
                          bgcolor:
                            m.status === "online"
                              ? "#10b981"
                              : m.status === "away"
                              ? "#f59e0b"
                              : "#94a3b8",

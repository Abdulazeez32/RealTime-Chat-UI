        </main>

        {/* PANE 3: CONTEXTUAL MEMBERS & FILES BAR (w-64) */}
        <aside className="w-64 border-l border-violet-100 bg-[#faf9ff]/80 p-4 flex-col justify-between hidden lg:flex space-y-5 overflow-y-auto">
          <div className="space-y-4">
            

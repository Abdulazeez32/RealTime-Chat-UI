          </div>
        </aside>

        {/* PANE 2: CENTRAL INTERACTIVE CHAT STREAM (flex-1) */}
        <main className="flex-1 flex flex-col justify-between bg-white overflow-hidden">
          
          {/* Channel Top Header */}
          <div className="h-16 border-b border-violet-100 px-6 flex items-center justify-between">
            <div className="flex items-center gap-2">
              <TagRoundedIcon sx={{ color: "#7c3aed" }} />
              <div>
                <h3 className="text-sm font-bold text-[#27213a] leading-none">{selectedChannel}</h3>
